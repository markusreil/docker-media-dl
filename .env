# ===== media-dl configuration =====
# `docker compose` reads this file automatically. It fails fast if a required
# variable is missing or empty.

# --- General ---
# Timezone, e.g. Europe/Amsterdam
TZ=Etc/UTC
# UID/GID that downloaded files should be owned by on the host
PUID=1000
PGID=1000

# --- nginx-proxy integration ---
# Name of the existing external docker network shared with nginx-proxy
NGINX_PROXY_NETWORK=web-proxy
# Domain under which every service is published via nginx-proxy: each
# container is exposed at <service>.<BASE_DOMAIN>, e.g. sabnzbd.localhost and
# prowlarr.localhost. Change BASE_DOMAIN to e.g. media-dl.localhost to switch all
# hostnames to sabnzbd.media-dl.localhost / prowlarr.media-dl.localhost in
# one place. VIRTUAL_HOST / LETSENCRYPT_HOST for each service are derived
# from this in docker-compose.yml.
BASE_DOMAIN=media-dl.localhost
# Contact email for Let's Encrypt registration
ACME_EMAIL=admin@example.com

# --- SABnzbd ---
SABNZBD_VERSION=5.1.3
# No SABNZBD_HOST_WHITELIST env var — the extra accepted hostnames are
# hardcoded in docker-compose.yml ("sabnzbd, sabnzbd.<BASE_DOMAIN>").
# SABnzbd API key (access token), shared with subsequent containers. Seeded
# into the config on first start; 32-char lowercase hex.
SABNZBD_API_KEY=5fe355bf3d014476a03675a679156d12
# SABnzbd NZB key for direct NZB download links; also seeded. Optional.
SABNZBD_NZB_KEY=632e7305174744f387e4fafb76216cc9

# --- Prowlarr ---
# Prowlarr (indexer manager, reached at prowlarr.<BASE_DOMAIN>).
PROWLARR_VERSION=2.6.5.5623
# Prowlarr API key (access token), seeded into config.xml on first start so
# other services can share a stable credential; 32-char lowercase hex.
PROWLARR_API_KEY=6a669c6d836c99cbb03ed28b8ce39e67

# --- qBittorrent ---
# qBittorrent (torrent client, reached at qbittorrent.<BASE_DOMAIN>).
QBT_VERSION=5.2.1
# No QBT_HOST_WHITELIST env var — the extra accepted hostnames are
# hardcoded in docker-compose.yml ("qbittorrent;qbittorrent.<BASE_DOMAIN>").
# Optional: comma-separated CIDR subnets that bypass the WebUI login (e.g. the
# docker network nginx-proxy attaches to, `docker network inspect
# <NGINX_PROXY_NETWORK>` to find it). Empty = login always required. Seeded on
# first start only (see qbittorrent/README.md for the reseed procedure).
QBT_AUTH_SUBNET_WHITELIST=172.18.0.0/16
# WebUI login username (default: admin).
QBT_WEBUI_USERNAME=admin
# WebUI login password - REQUIRED, seeded as a PBKDF2 hash on first start.
QBT_WEBUI_PASSWORD=replace-me
# Host port for bittorrent peer traffic (TCP+UDP), forwarded to the
# container's fixed port 6881. Must be reachable from the internet/VPN.
QBT_BT_PORT=6881

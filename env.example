# ===== media-dl configuration =====
# Copy to .env and edit: `cp env.example .env`.
# `docker compose` reads `.env` automatically. It fails fast if a required
# variable is missing or empty.
# Lifecycle: [build] = baked into the image at build time (needs a rebuild
# to change). [first-seed] = written into the service config on FIRST start
# only (needs the reseed procedure in the service README to change).
# [restart] = (re-)applied by the entrypoint on every start. Untagged vars
# apply live on `docker compose up -d`.

# --- Compose project ---
# Compose file list (colon-separated on Linux/macOS, `;` on Windows). Defaults
# to the base file; this makes it explicit and overridable. Listing more files
# registers them for every compose command without `-f`. To also serve the
# optional archived-library overlay (see "Media storage" below):
#   COMPOSE_FILE=docker-compose.yml:docker-compose.media-archived.yml
COMPOSE_FILE=docker-compose.yml

# --- General ---
# Timezone, e.g. Europe/Amsterdam
TZ=Etc/UTC
# UID/GID that downloaded files should be owned by on the host
PUID=1000
PGID=1000

# --- nginx-proxy integration ---
# Name of the existing external docker network shared with nginx-proxy.
# Optional; defaults to web-proxy (the proxy cluster's NGINX_PROXY_NETWORK).
NGINX_PROXY_NETWORK=web-proxy
# Domain under which every service is published via nginx-proxy: each
# container is exposed at <service>.<BASE_DOMAIN>, e.g. sabnzbd.localhost and
# prowlarr.localhost. Change BASE_DOMAIN to e.g. media-dl.localhost to switch all
# hostnames to sabnzbd.media-dl.localhost / prowlarr.media-dl.localhost in
# one place. VIRTUAL_HOST / ACME_HOST for each service are derived
# from this in docker-compose.yml.
BASE_DOMAIN=media-dl.localhost

# --- Media storage ---
# Shared /media library for Jellyfin (ro) and Radarr/Sonarr (rw). The NFS
# volume itself is read-write; only Jellyfin's compose mount adds :ro.
# Writable requirement: PUID:PGID must be able to write the export (the *arr
# apps import as that user) — chown the library on the NAS to match.
# Media source: regular volume (default) or NFS — env-var-only switch, no
# compose edit. Set to media-nfs to serve /media from NFS.
MEDIA_VOLUME=media-nfs
# NFS server hosting the media library — user fills in later.
MEDIA_NFS_HOST=nas.example.com
# NFS export path, e.g. /mnt/tank/media — user fills in later.
MEDIA_NFS_PATH=/mnt/tank/media
# NFS version: most servers speak v4, but pin 4 (negotiate minor) instead of
# 4.2 so a Linux client never hard-pins a minor the server may not serve.
MEDIA_NFS_VERS=4
# Archived library (OPTIONAL): second NFS export on the SAME host
# (MEDIA_NFS_HOST and MEDIA_NFS_VERS are reused — no separate host/version
# vars). Only used when the docker-compose.media-archived.yml overlay is
# registered via COMPOSE_FILE (see "Compose project" above):
#   COMPOSE_FILE=docker-compose.yml:docker-compose.media-archived.yml
# Leave unset to skip the archive entirely. When the overlay is registered, the
# export is mounted read-only at /media-archived in Jellyfin, Radarr and
# Sonarr (compose fails fast without this var).
MEDIA_ARCHIVED_NFS_PATH=/mnt/tank/archive
# Jellyfin's mount is read-only (ro: the server never writes to the library);
# Radarr/Sonarr mount the same volume read-write. hard: file ops retry
# forever instead of failing on transient server hiccups.

# --- SABnzbd ---
# [build] Pinned into the image; bump the version and rebuild to change it.
SABNZBD_VERSION=5.1.3
# No SABNZBD_HOST_WHITELIST env var — the extra accepted hostnames are
# hardcoded in docker-compose.yml ("sabnzbd, sabnzbd.<BASE_DOMAIN>").
# SABnzbd API key (access token), shared with subsequent containers. Seeded
# into the config on first start; 32-char lowercase hex.
# Generate a fresh value (e.g. `openssl rand -hex 16`) and copy it into .env.
# [first-seed] Changing it later needs a reseed (see sabnzbd/README.md).
# NOTE: Radarr and Sonarr also consume this on every (re)start to upsert
# their Sabnzbd download client via the API (see radarr/README.md and
# sonarr/README.md); a rotation converges on their restart without a reseed.
SABNZBD_API_KEY=addd816863202f69ec511af985327ba6
# SABnzbd NZB key for direct NZB download links; also seeded. Optional.
# Generate a fresh value (e.g. `openssl rand -hex 16`) and copy it into .env.
# [first-seed] Changing it later needs a reseed (see sabnzbd/README.md).
SABNZBD_NZB_KEY=d53218ae3ce76dbb39be6f9c850eb1e1
# Self-signed certificate opt-in for a LAN/self-signed proxy variant, wired
# to this service's GEN_SELF_SIGNED_CERT. Default false: most deployments are
# internet-facing and use ACME_HOST. Set true for a LAN/self-signed
# deployment (or local testing) where the proxy cluster's local cert
# generator is used instead.
SABNZBD_GEN_SELF_SIGNED_CERT=false

# --- Prowlarr ---
# Prowlarr (indexer manager, reached at prowlarr.<BASE_DOMAIN>).
# [build] Pinned into the image; bump the version and rebuild to change it.
PROWLARR_VERSION=2.6.5.5623
# Prowlarr API key (access token), seeded into config.xml on first start so
# other services can share a stable credential; 32-char lowercase hex.
# Generate a fresh value (e.g. `openssl rand -hex 16`) and copy it into .env.
# [first-seed] Changing it later needs a reseed (see prowlarr/README.md).
# NOTE: Radarr and Sonarr consume this on every (re)start for the Prowlarr
# Application upsert (see radarr/README.md and sonarr/README.md); a rotation
# converges on their restart without a reseed.
PROWLARR_API_KEY=35726e042ac92a6f9e9dc7edb9194c53
# Self-signed certificate opt-in for a LAN/self-signed proxy variant, wired
# to this service's GEN_SELF_SIGNED_CERT. Default false: most deployments are
# internet-facing and use ACME_HOST. Set true for a LAN/self-signed
# deployment (or local testing) where the proxy cluster's local cert
# generator is used instead.
PROWLARR_GEN_SELF_SIGNED_CERT=false

# --- Radarr ---
# Radarr (movie manager, reached at radarr.<BASE_DOMAIN>).
# [build] Pinned into the image; bump the version and rebuild to change it.
RADARR_VERSION=6.4.4.10685
# Radarr API key (access token), seeded into config.xml on first start so
# other services can share a stable credential; 32-char lowercase hex.
# Generate a fresh value (e.g. `openssl rand -hex 16`) and copy it into .env.
# [first-seed] Changing it later needs a reseed (see radarr/README.md).
RADARR_API_KEY=815665a0b51be0db3884e08a6196458e
# Self-signed certificate opt-in for a LAN/self-signed proxy variant, wired
# to this service's GEN_SELF_SIGNED_CERT. Default false: most deployments are
# internet-facing and use ACME_HOST. Set true for a LAN/self-signed
# deployment (or local testing) where the proxy cluster's local cert
# generator is used instead.
RADARR_GEN_SELF_SIGNED_CERT=false

# --- Sonarr ---
# Sonarr (TV series manager, reached at sonarr.<BASE_DOMAIN>).
# [build] Pinned into the image; bump the version and rebuild to change it.
SONARR_VERSION=4.0.20.3014
# Sonarr API key (access token), seeded into config.xml on first start so
# other services can share a stable credential; 32-char lowercase hex.
# Generate a fresh value (e.g. `openssl rand -hex 16`) and copy it into .env.
# [first-seed] Changing it later needs a reseed (see sonarr/README.md).
SONARR_API_KEY=dc6ef543257314720029e7d9b9a9908e
# The Sonarr entrypoint also consumes the shared SABNZBD_API_KEY,
# QBT_WEBUI_USERNAME / QBT_WEBUI_PASSWORD and PROWLARR_API_KEY on every
# (re)start to upsert its download clients and the Prowlarr Application
# (see sonarr/README.md); rotations converge on Sonarr restart.
# Self-signed certificate opt-in for a LAN/self-signed proxy variant, wired
# to this service's GEN_SELF_SIGNED_CERT. Default false: most deployments are
# internet-facing and use ACME_HOST. Set true for a LAN/self-signed
# deployment (or local testing) where the proxy cluster's local cert
# generator is used instead.
SONARR_GEN_SELF_SIGNED_CERT=false

# --- qBittorrent ---
# qBittorrent (torrent client, reached at qbittorrent.<BASE_DOMAIN>).
# [build] Pinned into the image; bump the version and rebuild to change it.
QBT_VERSION=5.2.1
# No QBT_HOST_WHITELIST env var — the extra accepted hostnames are
# hardcoded in docker-compose.yml ("qbittorrent;qbittorrent.<BASE_DOMAIN>").
# Optional: comma-separated CIDR subnets that bypass the WebUI login. Defaults to
# the full 172.16.0.0/12 private range so any docker network matches without
# having to map the NGINX_PROXY_NETWORK name to its subnet via
# `docker network inspect`. Empty = login always required. Seeded on
# first start only (see qbittorrent/README.md for the reseed procedure).
# [first-seed] Changing it later needs a reseed.
QBT_AUTH_SUBNET_WHITELIST=172.16.0.0/12
# WebUI login username (default: admin).
# [first-seed] Changing it later needs a reseed (see qbittorrent/README.md).
# NOTE: Radarr and Sonarr also consume this on every (re)start for their
# QBittorrent download-client upsert (see radarr/README.md and
# sonarr/README.md); a rotation converges on their restart without a reseed.
QBT_WEBUI_USERNAME=admin
# WebUI login password - REQUIRED, seeded as a PBKDF2 hash on first start.
# Copy the real password into .env (never commit it).
# [first-seed] Changing it later needs a reseed (see qbittorrent/README.md).
# NOTE: Radarr and Sonarr also consume this on every (re)start for their
# QBittorrent download-client upsert (see radarr/README.md and
# sonarr/README.md); a rotation converges on their restart without a reseed.
QBT_WEBUI_PASSWORD=replace-me
# Host port for bittorrent peer traffic (TCP+UDP), forwarded to the
# container's fixed port 6881. Must be reachable from the internet/VPN.
QBT_BT_PORT=6881
# Self-signed certificate opt-in for a LAN/self-signed proxy variant, wired
# to this service's GEN_SELF_SIGNED_CERT. Default false: most deployments are
# internet-facing and use ACME_HOST. Set true for a LAN/self-signed
# deployment (or local testing) where the proxy cluster's local cert
# generator is used instead.
QBITTORRENT_GEN_SELF_SIGNED_CERT=false

# --- Jellyfin ---
# Jellyfin (media server, reached at jellyfin.<BASE_DOMAIN>).
# Tracks the upstream jellyfin/jellyfin tag (e.g. 12.1 / 12.1.0); bump deliberately.
# [build] Pinned into the image; bump the version and rebuild to change it.
JELLYFIN_VERSION=12.1
# Jellyfin API key (access token), seeded into jellyfin.db ApiKeys on start
# so peers share a stable credential; 32-char lowercase hex.
# Fresh installs: the server creates the DB schema on 1st start and the key
# seeds on 2nd start — just restart once after first boot (it self-seeds on
# any later restart).
# Generate a fresh value (e.g. `openssl rand -hex 16`) and copy it into .env.
# [restart] Re-applied on every start; fresh installs converge on 2nd start.
JELLYFIN_API_KEY=f20b08e5f70d31ab1dd2d8efd3a51824
# Self-signed certificate opt-in for a LAN/self-signed proxy variant, wired
# to this service's GEN_SELF_SIGNED_CERT. Default false: most deployments are
# internet-facing and use ACME_HOST. Set true for a LAN/self-signed
# deployment (or local testing) where the proxy cluster's local cert
# generator is used instead.
JELLYFIN_GEN_SELF_SIGNED_CERT=false
